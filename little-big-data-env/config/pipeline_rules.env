# Spark Memory Allocation
SPARK_EXECUTOR_MEMORY=512m

# Synthetic Workload Generation Size
BATCH_SIZE=1000000

# Structured Streaming watermark configuration
SPARK_WATERMARK_LIMIT=10 minutes

