# Shape of a connection file for a remote Kafka with SASL_SSL and SCRAM-SHA-512.
# The broker's certificate is publicly trusted, so no CA file is needed.
KAFKA_BOOTSTRAP=broker.example.org:9094
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_USERNAME=your-user
KAFKA_PASSWORD=your-password
EVENTS_TOPIC=your-prefix.events
CARD_EVENTS_TOPIC=your-prefix.card-events
REF_TOPIC=your-prefix.ref
ALERTS_TOPIC=your-prefix.alerts
AUDIT_REPLIES_TOPIC=your-prefix.audit-replies
CONSUMER_GROUP=your-prefix.detector
