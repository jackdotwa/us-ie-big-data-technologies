# Kafka connection and topic names for the local Kafka (profile localkafka).
# To use another Kafka, put its file next to this one and set CONNECTION in .env (see the README).
KAFKA_BOOTSTRAP=kafka:19092
EVENTS_TOPIC=events
CARD_EVENTS_TOPIC=card-events
REF_TOPIC=ref
ALERTS_TOPIC=alerts
AUDIT_REPLIES_TOPIC=audit-replies
CONSUMER_GROUP=detector
